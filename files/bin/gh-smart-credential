#!/usr/bin/env bash
# Dynamic Git credential helper using GitHub CLI (gh) config.
# Automatically resolves tokens based on the URL path or requested account.

if [ "$1" != "get" ]; then
    exit 0
fi

input=$(cat)
host=$(echo "$input" | grep -E '^host=' | cut -d= -f2-)
path=$(echo "$input" | grep -E '^path=' | cut -d= -f2-)
username=$(echo "$input" | grep -E '^username=' | cut -d= -f2-)

if [ "$host" != "github.com" ]; then
    exit 1
fi

if [ -n "$username" ]; then
    user="$username"
elif [[ "$path" == i-stan_stratec/* ]]; then
    user="i-stan_stratec"
else
    user="viktorashi"
fi

token=$(awk -v u="$user" '
    $0 ~ "^ +" u ":" { in_user=1; next }
    in_user && /oauth_token:/ { print $2; exit }
    in_user && /^ +[a-zA-Z0-9_-]+:/ { exit }
' "${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml")

if [ -n "$token" ]; then
    echo "protocol=https"
    echo "host=github.com"
    echo "username=$user"
    echo "password=$token"
    exit 0
fi

exit 1
