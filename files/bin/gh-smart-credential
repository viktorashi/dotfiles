#!/usr/bin/env bash
# Dynamic Git credential helper using GitHub CLI (gh) config.
# Automatically resolves tokens based on:
# 1. username@ in the URL
# 2. owner/org in the repository path
# 3. active / last logged-in account in gh hosts.yml
# 4. default fallback to viktorashi

if [ "$1" != "get" ]; then
	exit 0
fi

input=$(cat)
host=$(echo "$input" | grep -E '^host=' | cut -d= -f2-)
path=$(echo "$input" | grep -E '^path=' | cut -d= -f2-)
username=$(echo "$input" | grep -E '^username=' | cut -d= -f2-)

if [ "$host" != "github.com" ]; then
	exit 1
fi

hosts_file="${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml"
[ -f "$hosts_file" ] || exit 1

get_token() {
	local target_user="$1"
	[ -z "$target_user" ] && return
	awk -v u="$target_user" '
		$0 ~ "^ +" u ":" { in_user=1; next }
		in_user && /oauth_token:/ { print $2; exit }
		in_user && /^ +[a-zA-Z0-9_-]+:/ { exit }
	' "$hosts_file"
}

get_active_user() {
	awk -F': ' '/^[[:space:]]+user:[[:space:]]*/ { gsub(/["\r]/, "", $2); print $2; exit }' "$hosts_file"
}

user=""
token=""

# 1. Precedence: username@ if provided and logged in
if [ -n "$username" ]; then
	token=$(get_token "$username")
	if [ -n "$token" ]; then
		user="$username"
	fi
fi

# 2. Precedence: owner in URL path (e.g. owner/repo)
if [ -z "$token" ] && [ -n "$path" ]; then
	clean_path="${path#/}"
	path_owner="${clean_path%%/*}"
	path_owner="${path_owner%.git}"
	token=$(get_token "$path_owner")
	if [ -n "$token" ]; then
		user="$path_owner"
	fi
fi

# 3. Precedence: active / last logged-in account in gh hosts.yml
if [ -z "$token" ]; then
	active_user=$(get_active_user)
	if [ -n "$active_user" ]; then
		token=$(get_token "$active_user")
		if [ -n "$token" ]; then
			user="$active_user"
		fi
	fi
fi

# 4. Fallback: viktorashi
if [ -z "$token" ]; then
	user="viktorashi"
	token=$(get_token "viktorashi")
fi

if [ -n "$token" ] && [ -n "$user" ]; then
	echo "protocol=https"
	echo "host=github.com"
	echo "username=$user"
	echo "password=$token"
	exit 0
fi

exit 1
