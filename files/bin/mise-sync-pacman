#!/usr/bin/env python3
import sys
import os
import re
import json
import hashlib
import shutil
import subprocess

def get_installed_capabilities():
    """Returns set of package names and provides already satisfied by installed packages (except mise-dummy-packages)."""
    try:
        out = subprocess.check_output(["pacman", "-Qi"], text=True)
    except Exception:
        return set()
    
    installed = set()
    current_pkg = None
    for line in out.splitlines():
        if line.startswith("Name"):
            current_pkg = line.split(":", 1)[1].strip()
            if current_pkg != "mise-dummy-packages":
                installed.add(current_pkg)
        elif line.startswith("Provides") and current_pkg != "mise-dummy-packages":
            parts = line.split(":", 1)[1].strip().split()
            for p in parts:
                if p != "None":
                    installed.add(p.split("=")[0])
    return installed

def main():
    # Only run on Arch Linux systems where pacman and makepkg exist
    if not shutil.which("pacman") or not shutil.which("makepkg"):
        return 0

    dotfiles_dir = os.environ.get("DOTFILES", os.path.expanduser("~/.dotfiles"))
    pkg_dir = os.path.join(dotfiles_dir, "files", "arch", "mise-dummy-packages")
    os.makedirs(pkg_dir, exist_ok=True)
    pkgbuild_path = os.path.join(pkg_dir, "PKGBUILD")
    hash_file = os.path.join(pkg_dir, ".mise_hash")

    # Get mise tools
    try:
        raw_json = subprocess.check_output(["mise", "ls", "--json"], text=True)
        all_tools = json.loads(raw_json)
    except Exception as e:
        print(f"[mise-sync-pacman] Could not query mise: {e}", file=sys.stderr)
        return 0

    installed_caps = get_installed_capabilities()

    SPECIAL_MAP = {
        "node": ["nodejs", "node"],
        "rust": ["rust", "cargo"],
        "tree-sitter": ["tree-sitter", "tree-sitter-cli"],
        "taplo": ["taplo", "taplo-cli"],
        "docker/cli": ["docker"],
        "rg": ["ripgrep"],
        "sh": ["shfmt"],
    }

    IGNORE_SET = {
        "bash", "sh", "coreutils", "findutils", "gawk", "grep", "sed", "tar", "zsh"
    }

    def clean_version(v):
        if not v:
            return ""
        v = v.split()[0]
        v = v.replace("-", ".")
        v = re.sub(r"[^0-9a-zA-Z._]", "", v)
        return v

    provides = set()

    for key, list_val in all_tools.items():
        installed_versions = [entry for entry in list_val if entry.get("installed")]
        if not installed_versions:
            continue
        active = [e for e in installed_versions if e.get("active")]
        entry = active[0] if active else installed_versions[-1]
        ver = clean_version(entry.get("version", ""))

        raw = key
        if ":" in raw:
            _, raw = raw.split(":", 1)

        if raw in SPECIAL_MAP:
            names = SPECIAL_MAP[raw]
        elif "/" in raw:
            if raw.startswith("@"):
                names = [raw.replace("@", "").replace("/", "-")]
            else:
                names = [raw.split("/")[-1]]
        else:
            names = [raw]

        for n in names:
            if n.startswith("types-") or n == "@types":
                continue
            n = n.lower()
            if not re.match(r"^[a-z0-9@._+-]+$", n):
                continue
            if n in IGNORE_SET:
                continue
            # If system already has a package providing this, skip to avoid conflicts
            if n in installed_caps:
                continue

            if ver:
                provides.add(f"{n}={ver}")
            provides.add(n)

    if not provides:
        print("[mise-sync-pacman] No missing packages to provide.")
        return 0

    sorted_provides = sorted(provides)
    content_hash = hashlib.sha256("\n".join(sorted_provides).encode()).hexdigest()[:16]

    # Check if already up to date
    if "--auto" in sys.argv and os.path.exists(hash_file):
        with open(hash_file, "r") as f:
            if f.read().strip() == content_hash:
                ret = subprocess.run(["pacman", "-Q", "mise-dummy-packages"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if ret.returncode == 0:
                    return 0

    # Build PKGBUILD content
    provides_str = "\n".join([f"  '{p}'" for p in sorted_provides])
    pkgbuild_content = f"""# Auto-generated by mise-sync-pacman. Do not edit manually.
pkgname=mise-dummy-packages
pkgver=1.0.{content_hash}
pkgrel=1
pkgdesc="Dummy metapackage satisfying pacman dependencies provided by mise"
arch=('any')
license=('custom')
provides=(
{provides_str}
)

package() {{
  mkdir -p "$pkgdir/usr/share/doc/$pkgname"
  cat << 'INFO' > "$pkgdir/usr/share/doc/$pkgname/README"
This metapackage was automatically generated from tools installed in mise.
It registers their capabilities in pacman so that yay/makepkg does not download
redundant toolchains (like go, nodejs, rust, etc.).
INFO
}}
"""

    with open(pkgbuild_path, "w") as f:
        f.write(pkgbuild_content)

    print(f"[mise-sync-pacman] Generating and installing mise-dummy-packages ({len(sorted_provides)} provided entries)...")

    build_dir = "/tmp/build-mise-dummy-packages"
    if os.path.exists(build_dir):
        shutil.rmtree(build_dir)
    os.makedirs(build_dir, exist_ok=True)

    shutil.copyfile(pkgbuild_path, os.path.join(build_dir, "PKGBUILD"))

    try:
        subprocess.check_call(["makepkg", "-f"], cwd=build_dir)
        pkg_files = [f for f in os.listdir(build_dir) if f.endswith(".pkg.tar.zst")]
        if not pkg_files:
            print("[mise-sync-pacman] ERROR: Package was not generated", file=sys.stderr)
            return 1

        pkg_file = os.path.join(build_dir, pkg_files[0])
        subprocess.check_call(["sudo", "pacman", "-U", "--noconfirm", pkg_file])

        with open(hash_file, "w") as f:
            f.write(content_hash)

        print("[mise-sync-pacman] Successfully updated and installed mise-dummy-packages!")
    finally:
        shutil.rmtree(build_dir, ignore_errors=True)

    return 0

if __name__ == "__main__":
    sys.exit(main())
