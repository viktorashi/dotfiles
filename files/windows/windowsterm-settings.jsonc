{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": {
        "action": "copy",
        "singleLine": false
      },
      "keys": "alt+c"
    },
    {
      "command": {
        "action": "newTab"
      },
      "keys": "ctrl+shift+t"
    },
    {
      "command": "paste",
      "keys": "alt+v"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 0
      },
      "keys": "alt+1"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 1
      },
      "keys": "alt+2"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 2
      },
      "keys": "alt+3"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 3
      },
      "keys": "alt+4"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 4
      },
      "keys": "alt+5"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 5
      },
      "keys": "alt+6"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 6
      },
      "keys": "alt+7"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 7
      },
      "keys": "alt+8"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 8
      },
      "keys": "alt+9"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "auto",
        "splitMode": "duplicate"
      }
    },
    {
      "command": "find",
      "keys": "ctrl+shift+f"
    },
    // TODO: asta ar trebui pusă in tmux direct.
    // {
    //   "command": "find",
    //   "keys": "alt+f"
    // },
    {
      "command": {
        "action": "newTab"
      },
      "keys": "alt+t"
    }
  ],
  "copyFormatting": "none",
  "copyOnSelect": false,
  "defaultProfile": "archlinux",
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  //TODO: și background image ar trebui per-machine
  "profiles": {
    //TODO: tot per-machine, n-am nevoie de toate peste tot, și nu la fel
    //TODO: distro-id-u ăsta chiar nu știu dacă e reprod.
    "defaults": {
      // "backgroundImage": "C:/Users/Victor/Pictures/iCloud Photos/Photos/87247FC3-1833-4A08-9EE9-7300CF15D27A_1_105_c.jpeg",
      // "backgroundImageAlignment": "center",
      // "backgroundImageOpacity": 0.1,
      // "backgroundImageStretchMode": "fill",
      // "colorScheme": "Tango Dark",
      //TODO: cumva templateuit peste tot cu dotter
      // "font": {
      //   "face": "JetBrainsMono Nerd Font",
      //   "size": 11.5
      // }
    },
    //TODO: tot per-machine, n-am nevoie de toate peste tot, și nu la fel
    "list": [
      {
        "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "hidden": false,
        "name": "Windows PowerShell"
      },
      {
        "commandline": "%SystemRoot%\\System32\\cmd.exe",
        "hidden": false,
        "name": "Command Prompt"
      },
      {
        //TODO: distro-id-u ăsta chiar nu știu dacă e reprod.
        "commandline": "C:\\WINDOWS\\system32\\wsl.exe --distribution archlinux",
        "hidden": false,
        "icon": "archlinux.ico",
        "name": "archlinux",
        "source": "Microsoft.WSL"
      }
    ]
  },
  "schemes": [],
  // "searchWebDefaultQueryUrl": "https://www.google.com/search?q=%22%s%22",
  "theme": "dark",
  "themes": []
}
