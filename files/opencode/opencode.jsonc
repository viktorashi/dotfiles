// nativ, opencode nu scrie direct aici cand schimbi configu live *din* el, asa ca sunt unele fisiere live care tin configu pe care chiar il are in momentu ala, si aici sunt doar niste override-uri care sunt trackable. Cam astea sunt mappingurile de la live -> dotfiles
//
// `~/.local/state/opencode/kv.json`
//
// ~/.local/share/opencode/project/<project-slug>/storage/ -> .opencode/ project config lives separately, but sessions/messages are not config
// ~/.local/share/opencode/kv.json (c) -> ~/.config/opencode/cli.json (c)
// ~/.local/state/opencode/kv.json (c) -> ~/.config/opencode/cli.json (c)
// ~/.local/share/opencode/opencode.json (c) -> ~/.config/opencode/opencode.json (c)
//
// restu project-specific mai poate fi overloadut si din 
//
// <project>/.opencode/opencode.json # project server config
//
{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": true,
  "update": "disable",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "formatter": {},
  "lsp": {},
  "policies": [
    {
      "effect": "deny",
      "action": "provider.use",
      "resource": "opencode"
    }
  ],
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": true
      },
      "github-personal": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      },
      "github-work": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_WORK_ACCESS_TOKEN}"
        },
        "disabled": true
      }
    }
  },
  "providers": {
    "google": {
      "package": "aisdk:@ai-sdk/google",
      "settings": {
        "websearch_cited": {
          "model": "gemini-2.5-flash"
        }
      }
    },
    "stratec-dgx-spark": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Sparku nostru",
      "settings": {
        "baseURL": "http://spark-da41.intern.stratec.com/codellm/v1",
        "apiKey": "{env:SPARK_API_KEY}"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "qwen3.8-flash-next"
        }
      }
    }
  },
  // VibeGuard's dual-version adapter is kept in the personal projects-repos clone.
  // Cited-search and show-tools still expose only the V1 API; the PTY V2 subpath
  // fails to resolve in this CLI and is left disabled until its loader path works.
  "plugins": [
    "file://{env:HOME}/projects-repos/opencode-vibeguard",
    "@prevalentware/opencode-goal-plugin",
    "git+https://github.com/anomalyco/opencode-plugin-lane.git"
  ]
}
