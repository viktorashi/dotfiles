{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "animations": true,
  "diffs": {
    "wrap": "word",
    "single": true,
    "fullscreen": false,
    "tree": true,
    "view": "unified"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home",
    "session.move": "ctrl+shift+m"

  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "low"
  },
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "prompt": {
    "image_preview": true,
    "editor": true
  }
}
