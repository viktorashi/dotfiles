{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "animations": true,
  "diffs": {
    "wrap": "word",
    "single": true,
    "fullscreen": false,
    "tree": true,
    "view": "unified"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ]
}
