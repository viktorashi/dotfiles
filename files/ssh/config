# Machine-specific hosts live in a separate, deployed file.
# ssh silently ignores an Include whose file does not exist.
Include ~/.ssh/config.d/*

#  stratec-db14 server
Host db14
  User rvsclient
  HostName stratec-db14.intern.stratec.com

#  qas-jumphost server
Host qas-jumphost
  User qas
  HostName 4.223.163.118
  IdentityFile ~/.ssh/id_ec_qasjumphost
  IdentitiesOnly yes

Host raspi
  User pi
  HostName 10.5.202.87

# conecteazate la CentOS-u ala vechi
Host centos-vm
    HostName 192.168.64.4
    User viktorashi
    IdentityFile ~/.ssh/id_vms
    KexAlgorithms +diffie-hellman-group14-sha1
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa

# acasica PCu de windows 11
Host acas
    HostName  viktorashi.home.ro
    User victor
    IdentityFile ~/.ssh/id_ed25519

# super quick daca vrei sa te joci cu SSH
Host localhostrun
    HostName  localhost.run
    User nokey
    IdentityFile ~/.ssh/localhostrun

Host spark-da41:
  HostName spark-da41.intern.stratec.com
  User vstan
  IdentityFile ~/.ssh/id_ed25519_auth

Host *
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/cm-%C
  ControlPersist 5m
