# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login exists.

# if running bash, include .bashrc
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

# =======================
# Working with the $PATH |
# =======================
[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/.local/share/pipx/venvs" ] && PATH="$HOME/.local/share/pipx/venvs:$PATH"
[ -d "/usr/local/go/bin" ] && PATH="$PATH:/usr/local/go/bin"
[ -d "$HOME/go/bin" ] && PATH="$PATH:$HOME/go/bin"
[ -d "$HOME/.fly/bin" ] && PATH="$HOME/.fly/bin:$PATH"
export PATH

# =========================================
# Restu de exporturi care nu sunt $PATH    |
# =========================================
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

export EDITOR="nvim"
export VISUAL="nvim"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"

# Make scripts launched through `bun run` use Bun for Node shebangs/subprocesses too.
case " ${BUN_OPTIONS:-} " in
  *" --bun "*) ;;
  *) export BUN_OPTIONS="${BUN_OPTIONS:+$BUN_OPTIONS }--bun" ;;
esac

# rust
[ -x "$HOME/.cargo/bin/sccache" ] && export RUSTC_WRAPPER="$HOME/.cargo/bin/sccache"

export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
export GPG_TTY=$(tty)

export PASTEL_COLOR_MODE=24bit
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export OPENCODE_ENABLE_EXA=1

# ==========================================================================
# Everything that is true of THIS machine only. Deployed by dotter from     |
# .config/shell/machines/<machine>.sh — absent on a machine that needs none.|
# ==========================================================================
[ -f "$HOME/.config/shell/machine.sh" ] && . "$HOME/.config/shell/machine.sh"
