# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login exists.

# if running bash, include .bashrc
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

# =========================================================
# Copy-on-Write (XFS) Storage on /mnt/fast-cow             |
# All package managers read/write caches and data here.   |
# =========================================================
if [ -d "/mnt/fast-cow" ]; then
  export FAST_COW_DIR="/mnt/fast-cow"
  export XDG_CACHE_HOME="/mnt/fast-cow/cache"
  export UV_CACHE_DIR="/mnt/fast-cow/cache/uv"
  export PIP_CACHE_DIR="/mnt/fast-cow/cache/pip"
  export SCCACHE_DIR="/mnt/fast-cow/cache/sccache"
  export PNPM_HOME="/mnt/fast-cow/pnpm"
  export MISE_DATA_DIR="/mnt/fast-cow/mise"
  export MISE_CACHE_DIR="/mnt/fast-cow/cache/mise"
  export CARGO_HOME="/mnt/fast-cow/cargo"
  export RUSTUP_HOME="/mnt/fast-cow/rustup"
  export GOPATH="/mnt/fast-cow/go"
  export GOMODCACHE="/mnt/fast-cow/go/pkg/mod"
  export BUN_INSTALL="/mnt/fast-cow/bun"
fi

# =======================
# Working with the $PATH |
# =======================
[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/.local/share/pipx/venvs" ] && PATH="$HOME/.local/share/pipx/venvs:$PATH"
[ -d "/usr/local/go/bin" ] && PATH="$PATH:/usr/local/go/bin"
[ -d "${GOPATH:-$HOME/go}/bin" ] && PATH="$PATH:${GOPATH:-$HOME/go}/bin"
[ -d "${CARGO_HOME:-$HOME/.cargo}/bin" ] && PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
[ -d "${PNPM_HOME:-$HOME/.local/share/pnpm}" ] && PATH="${PNPM_HOME:-$HOME/.local/share/pnpm}:$PATH"
[ -d "${BUN_INSTALL:-$HOME/.bun}/bin" ] && PATH="${BUN_INSTALL:-$HOME/.bun}/bin:$PATH"
[ -d "$HOME/.fly/bin" ] && PATH="$HOME/.fly/bin:$PATH"
export PATH

# =========================================
# Restu de exporturi care nu sunt $PATH    |
# =========================================
[ -f "${CARGO_HOME:-$HOME/.cargo}/env" ] && . "${CARGO_HOME:-$HOME/.cargo}/env"

export EDITOR="nvim"
export VISUAL="nvim"

# Make scripts launched through `bun run` use Bun for Node shebangs/subprocesses too.
case " ${BUN_OPTIONS:-} " in
  *" --bun "*) ;;
  *) export BUN_OPTIONS="${BUN_OPTIONS:+$BUN_OPTIONS }--bun" ;;
esac

# rust
[ -x "${CARGO_HOME:-$HOME/.cargo}/bin/sccache" ] && export RUSTC_WRAPPER="${CARGO_HOME:-$HOME/.cargo}/bin/sccache"

export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$(gpgconf --list-dirs agent-ssh-socket 2>/dev/null)}"
export GPG_TTY=$(tty 2>/dev/null || true)

export PASTEL_COLOR_MODE=24bit
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export OPENCODE_ENABLE_EXA=1

# ==========================================================================
# Everything that is true of THIS machine only. Deployed by dotter from     |
# .config/shell/machines/<machine>.sh — absent on a machine that needs none.|
# ==========================================================================
[ -f "$HOME/.config/shell/machine.sh" ] && . "$HOME/.config/shell/machine.sh"
