#!/bin/bash

# Find the real git binary by dynamically removing the directory containing this script from PATH
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEAN_PATH=$(echo "$PATH" | sed -e "s|${SCRIPT_DIR}:||g" -e "s|${SCRIPT_DIR}$||g")
REAL_GIT=$(PATH="$CLEAN_PATH" command -v git)

# 1. Determine if we are operating on the .cfg repo
IS_CFG_REPO=false
if [[ "${GIT_DIR}" == *".cfg"* ]]; then
  IS_CFG_REPO=true
fi

# Also check command line arguments for the repo path and checkout commands
IS_CHECKOUT=false
for arg in "$@"; do
  if [[ "$arg" == *".cfg"* ]]; then
    IS_CFG_REPO=true
  fi
  if [[ "$arg" == "checkout" || "$arg" == "switch" || "$arg" == "co" || "$arg" == "sw" ]]; then
    IS_CHECKOUT=true
  fi
done

# 2. If it's a checkout in the config repo, use the safe wrapper logic
if [[ "$IS_CFG_REPO" == true && "$IS_CHECKOUT" == true ]]; then
  tmp_err=$(mktemp)
  
  "$REAL_GIT" "$@" 2> "$tmp_err"
  exit_code=$?
  
  if [[ "$exit_code" -ne 0 ]]; then
    err_content=$(cat "$tmp_err")
    
    if [[ "$err_content" == *"would be overwritten by"* ]]; then
      conflicting_files=$(echo "$err_content" | grep -E $'^\t' | sed $'s/^\t//')
      
      if [[ -n "$conflicting_files" ]]; then
        base_dir="$HOME/backup_$(date +%Y-%m-%d)"
        counter=1
        backup_dir="${base_dir}_${counter}"
        while [[ -d "$backup_dir" ]]; do
          ((counter++))
          backup_dir="${base_dir}_${counter}"
        done
        
        echo "⚠️  Conflicting files detected. Backing up to: $backup_dir" >&2
        mkdir -p "$backup_dir"
        
        while IFS= read -r file; do
          [[ -z "$file" ]] && continue
          local_path="$HOME/$file"
          if [[ -e "$local_path" ]]; then
            dest_path="$backup_dir/$file"
            mkdir -p "$(dirname "$dest_path")"
            echo "📦 Moving $file -> $dest_path" >&2
            mv "$local_path" "$dest_path"
          fi
        done <<< "$conflicting_files"
        
        rm -f "$tmp_err"
        echo "🔄 Retrying command..." >&2
        
        # Replace current process with the real git retry
        exec "$REAL_GIT" "$@"
      fi
    fi
    
    cat "$tmp_err" >&2
    rm -f "$tmp_err"
    exit "$exit_code"
  else
    rm -f "$tmp_err"
    exit 0
  fi
else
  # 3. For all other repos and commands, seamlessly pass straight to the real git
  exec "$REAL_GIT" "$@"
fi
